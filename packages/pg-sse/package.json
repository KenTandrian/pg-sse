{
  "name": "pg-sse",
  "version": "0.1.2",
  "description": "Real-time PostgreSQL subscriptions for Next.js & React via SSE",
  "author": "Kenrick Tandrian <kenricktan11@gmail.com>",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "pg": ">=8.11.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "sse",
    "server-sent-events",
    "react",
    "nextjs",
    "realtime",
    "subscription",
    "listen",
    "notify"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KenTandrian/pg-sse.git",
    "directory": "packages/pg-sse"
  },
  "license": "MIT"
}
